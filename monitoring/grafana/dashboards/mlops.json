{
  "title": "Vehicle & Sentiment MLOps",
  "uid": "mlops-main",
  "version": 1,
  "schemaVersion": 38,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Total Predictions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(sentiment_predictions_total)",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 2,
      "title": "Positive vs Negative Ratio",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum by(label) (sentiment_predictions_total)",
          "legendFormat": "{{label}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Prediction Latency (p95)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(sentiment_prediction_duration_seconds_bucket[5m]))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Vehicle Operations",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(vehicle_operations_total[5m])",
          "legendFormat": "{{operation}} - {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Prediction Errors",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 14, "y": 0 },
      "targets": [
        {
          "expr": "sentiment_prediction_errors_total",
          "legendFormat": "Errors"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    }
  ]
}
